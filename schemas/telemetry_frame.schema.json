{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/osiris-dnalang/organism_sim/schemas/telemetry_frame.schema.json",
  "title": "organism_sim telemetry frame (capture_frame)",
  "description": "Structured snapshot of one running organism at one bridge tick. Layers that do not exist on the target are null; nothing is synthesised.",
  "type": "object",
  "required": ["schema", "tick", "organism", "learner", "topology", "regulation",
               "cusum", "cusum_threshold", "error", "active_genes", "status"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "organism_sim.telemetry_frame/1"},
    "tick": {"type": "integer", "minimum": 0},
    "status": {"enum": ["stable", "degraded", "critical", "idle"]},
    "cusum": {"type": ["number", "null"], "minimum": 0},
    "cusum_threshold": {"type": ["number", "null"], "minimum": 0},
    "error": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "active_genes": {"type": "array", "items": {"type": "string"}},
    "organism": {
      "type": "object",
      "required": ["name", "tick", "generation", "status", "phase", "state", "metrics", "counters",
                   "sink_load", "unrepaired_integral", "events", "decision", "confidence", "n_genes",
                   "genome_fingerprint", "audit_head", "chain_length", "triggers"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "tick": {"type": "integer", "minimum": 0},
        "generation": {"type": "integer", "minimum": 0},
        "status": {"enum": ["stable", "degraded", "critical", "idle"]},
        "phase": {"enum": ["ingest", "update", "decide", "maintain", "log"]},
        "state": {
          "type": "object",
          "required": ["coherence", "noise_rate", "entropy_bits", "phase_deg", "efficiency"],
          "additionalProperties": false,
          "properties": {
            "coherence": {"type": "number", "minimum": 0, "maximum": 1},
            "noise_rate": {"type": "number", "minimum": 0},
            "entropy_bits": {"type": "number", "minimum": 0},
            "phase_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
            "efficiency": {"type": "number", "minimum": 0}
          }
        },
        "metrics": {
          "type": "object",
          "required": ["repair_headroom", "coherence", "cycle_position", "input_quality",
                       "decision_confidence", "load_headroom"],
          "additionalProperties": false,
          "properties": {
            "repair_headroom": {"type": "number", "minimum": 0, "maximum": 1},
            "coherence": {"type": "number", "minimum": 0, "maximum": 1},
            "cycle_position": {"type": "number", "minimum": 0, "maximum": 1},
            "input_quality": {"type": "number", "minimum": 0, "maximum": 1},
            "decision_confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "load_headroom": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "counters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "sink_load": {"type": "number", "minimum": 0},
        "unrepaired_integral": {"type": "number", "minimum": 0},
        "events": {"type": "array", "items": {"type": "string"}},
        "decision": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "n_genes": {"type": "integer", "minimum": 1},
        "genome_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chain_length": {"type": "integer", "minimum": 0},
        "triggers": {"type": "object", "additionalProperties": {"type": "number"}}
      }
    },
    "learner": {
      "type": ["object", "null"],
      "required": ["name", "trial", "input_len", "symbols", "macro", "micro", "p_explore",
                   "last_action", "last_explore", "confidence", "engine_counters", "structural",
                   "frozen", "cusum"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "trial": {"type": "integer", "minimum": 0},
        "input_len": {"type": "integer", "minimum": 1},
        "symbols": {"type": "array", "items": {"type": "string"}},
        "macro": {"type": "integer", "minimum": 0},
        "micro": {"type": "integer", "minimum": 0},
        "p_explore": {"type": "number", "minimum": 0, "maximum": 1},
        "last_action": {"type": ["string", "null"]},
        "last_explore": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "engine_counters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "structural": {"type": "boolean"},
        "frozen": {"type": "boolean"},
        "cusum": {
          "type": ["object", "null"],
          "required": ["signal", "s", "h", "mu0", "k", "fires"],
          "additionalProperties": false,
          "properties": {
            "signal": {"enum": ["pressure", "error"]},
            "s": {"type": "number", "minimum": 0},
            "h": {"type": "number"},
            "mu0": {"type": "number"},
            "k": {"type": "number"},
            "fires": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "topology": {
      "type": ["object", "null"],
      "required": ["routes", "peers", "bus_nodes", "on_bus", "severed", "reroutes", "last_reroute",
                   "inbox", "credits_received"],
      "additionalProperties": false,
      "properties": {
        "routes": {"type": "array", "items": {"type": "string"}},
        "peers": {"type": "array", "items": {"type": "string"}},
        "bus_nodes": {"type": "array", "items": {"type": "string"}},
        "on_bus": {"type": "boolean"},
        "severed": {"type": "integer", "minimum": 0},
        "reroutes": {"type": "integer", "minimum": 0},
        "last_reroute": {
          "type": ["object", "null"],
          "required": ["trial", "to", "why"],
          "properties": {
            "trial": {"type": "integer"}, "to": {"type": "string"}, "why": {"type": "string"}
          }
        },
        "inbox": {"type": "integer", "minimum": 0},
        "credits_received": {"type": "integer", "minimum": 0}
      }
    },
    "regulation": {
      "type": ["object", "null"],
      "required": ["tick", "metrics", "cusum", "active_genes", "board", "order", "expressions",
                   "injections", "since_inject", "since_shift_est", "genes", "genome_version",
                   "genome_fingerprint"],
      "additionalProperties": false,
      "properties": {
        "tick": {"type": "integer", "minimum": 0},
        "metrics": {
          "type": "object",
          "required": ["error", "acc", "cusum", "noise_rate", "entropy_bits", "since_inject",
                       "since_shift_est", "tick", "explore", "last_error"],
          "additionalProperties": false,
          "properties": {
            "error": {"type": "number", "minimum": 0, "maximum": 1},
            "acc": {"type": "number", "minimum": 0, "maximum": 1},
            "cusum": {"type": "number", "minimum": 0},
            "noise_rate": {"type": "number", "minimum": 0},
            "entropy_bits": {"type": "number", "minimum": 0},
            "since_inject": {"type": "number", "minimum": 0},
            "since_shift_est": {"type": "number", "minimum": 0},
            "tick": {"type": "number", "minimum": 0},
            "explore": {"type": "number", "minimum": 0, "maximum": 1},
            "last_error": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "cusum": {
          "type": "object",
          "required": ["s", "h", "mu0", "k", "over"],
          "additionalProperties": false,
          "properties": {
            "s": {"type": "number", "minimum": 0},
            "h": {"type": "number"},
            "mu0": {"type": "number"},
            "k": {"type": "number"},
            "over": {"type": "boolean"}
          }
        },
        "active_genes": {"type": "array", "items": {"type": "string"}},
        "board": {"type": "array", "items": {"type": "string"}},
        "order": {"type": "array", "items": {"type": "string"}},
        "expressions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "injections": {"type": "integer", "minimum": 0},
        "since_inject": {"type": "integer", "minimum": 0},
        "since_shift_est": {"type": "integer", "minimum": 0},
        "genes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "trigger", "action", "kind", "dependencies", "outputs", "cluster"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "trigger": {"type": "string"},
              "action": {"type": "string"},
              "kind": {"enum": ["rule", "regulator"]},
              "dependencies": {"type": "array", "items": {"type": "string"}},
              "outputs": {"type": "array", "items": {"type": "string"}},
              "cluster": {"type": "string"}
            }
          }
        },
        "genome_version": {"type": "integer", "minimum": 1},
        "genome_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
      }
    }
  }
}
