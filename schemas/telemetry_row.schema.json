{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/osiris-dnalang/organism_sim/schemas/telemetry_row.schema.json",
  "title": "organism_sim telemetry row (AuditChain)",
  "description": "One tick of one organism. hash = SHA-256(prev_hash || canonical JSON of all other fields). Chain starts at prev_hash = 64 zeros.",
  "type": "object",
  "required": ["tick", "timestamp", "state", "metrics", "decision", "confidence", "events",
               "generation", "sink_load", "prev_hash", "hash"],
  "additionalProperties": false,
  "properties": {
    "tick": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "number"},
    "state": {
      "type": "object",
      "required": ["coherence", "noise_rate", "entropy_bits", "phase_deg", "efficiency"],
      "additionalProperties": false,
      "properties": {
        "coherence": {"type": "number", "minimum": 0, "maximum": 1},
        "noise_rate": {"type": "number", "minimum": 0},
        "entropy_bits": {"type": "number", "minimum": 0},
        "phase_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
        "efficiency": {"type": "number", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "required": ["repair_headroom", "coherence", "cycle_position", "input_quality",
                   "decision_confidence", "load_headroom"],
      "additionalProperties": false,
      "properties": {
        "repair_headroom": {"type": "number", "minimum": 0, "maximum": 1},
        "coherence": {"type": "number", "minimum": 0, "maximum": 1},
        "cycle_position": {"type": "number", "minimum": 0, "maximum": 1},
        "input_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "decision_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "load_headroom": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "decision": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "events": {"type": "array", "items": {"type": "string"}},
    "generation": {"type": "integer", "minimum": 0},
    "sink_load": {"type": "number", "minimum": 0},
    "prev_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
